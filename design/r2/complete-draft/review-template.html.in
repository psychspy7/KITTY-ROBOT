<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>KITTY R2.1 · Detachable tail review</title>
<style>
:root{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#edf1f2;background:#111719;--amber:#ffd083;--muted:#a8b6bc;--line:#354248}
*{box-sizing:border-box}body{margin:0}header,main,footer{max-width:1180px;margin:auto;padding:20px 24px}header{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);gap:12px}.brand{font-size:18px;letter-spacing:3px;font-weight:750}.brand small{font-size:11px;color:var(--muted);letter-spacing:1.5px}.badge{font-size:10px;color:var(--amber);border:1px solid #756344;border-radius:30px;padding:7px 10px;white-space:nowrap}h1{font-size:clamp(28px,5vw,44px);line-height:1.1;letter-spacing:-1.2px;margin:12px 0}p{font-size:14px;line-height:1.6;color:var(--muted);margin:8px 0}.intro{margin-bottom:18px}.review{border:1px solid var(--line);border-radius:15px;overflow:hidden;background:#1b252a}.view-radio{position:absolute;opacity:0;pointer-events:none}.views{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:14px;border-bottom:1px solid var(--line)}button,.views label,a.save{font:inherit;font-size:13px;border:1px solid #435158;border-radius:8px;padding:10px 15px;color:#e9eff1;background:#26333a;cursor:pointer;text-decoration:none}button:hover,.views label:hover,a.save:hover{border-color:var(--amber)}button:disabled{opacity:.55;cursor:default}button:focus-visible,a:focus-visible,.view-radio:focus-visible~.views{outline:3px solid var(--amber);outline-offset:3px}.views .spacer{flex:1}#view-iso:checked~.views label[for=view-iso],#view-front:checked~.views label[for=view-front],#view-rear:checked~.views label[for=view-rear],#view-inside:checked~.views label[for=view-inside],#view-side:checked~.views label[for=view-side],#view-joint:checked~.views label[for=view-joint]{background:#ffd08320;color:var(--amber);border-color:var(--amber)}.stage{height:clamp(380px,64vh,760px);position:relative;background:#f0f4fa}.stage figure{display:none;margin:0;height:100%;width:100%;align-items:center;justify-content:center}.stage img{display:block;max-width:100%;height:100%;object-fit:contain}#view-iso:checked~.stage .iso,#view-front:checked~.stage .front,#view-rear:checked~.stage .rear,#view-inside:checked~.stage .inside,#view-side:checked~.stage .side,#view-joint:checked~.stage .joint{display:flex}.stage canvas{display:none;width:100%;height:100%;touch-action:none;cursor:grab}.stage canvas:active{cursor:grabbing}.review.interactive .stage figure{display:none!important}.review.interactive canvas{display:block}.orbit{display:none;flex-wrap:wrap;gap:8px;padding:12px 15px;border-top:1px solid var(--line)}.review.interactive .orbit{display:flex}.orbit span{font-size:12px;color:var(--muted);align-self:center}.state{padding:12px 16px;margin:0;background:#172126;font-size:12px;min-height:42px}.facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:18px 0}.fact{padding:16px;border:1px solid var(--line);border-radius:12px}.fact strong{display:block;font-size:17px;margin:7px 0}.fact span{font-size:12px;color:var(--muted)}.below{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin:20px 0}.below h2{font-size:17px;margin:0 0 8px}.below p,.below li{font-size:13px;color:var(--muted);line-height:1.65}.below ul{padding-left:20px}details{border:1px solid var(--line);padding:16px;border-radius:12px}summary{cursor:pointer;font-size:14px;font-weight:650}.save{display:inline-block;margin-top:10px}footer{font-size:11px;color:#8699a2;padding-top:0}noscript p{padding:12px 16px;margin:0}.no-mesh #enable3d{display:none}
@media(max-width:650px){header,main,footer{padding-left:14px;padding-right:14px}.brand small{display:none}.views{gap:6px;padding:10px}.views label,button{font-size:12px;padding:9px 11px}.views .spacer{display:none}.stage{height:440px}.stage figure:not(.joint) img{width:100%;object-fit:cover}.facts{grid-template-columns:1fr;gap:8px}.fact{padding:11px 14px;display:flex;gap:10px;justify-content:space-between;align-items:center}.fact strong{font-size:14px;margin:0}.fact span{font-size:11px}.below{grid-template-columns:1fr}.orbit span{width:100%}}
</style>
</head>
<body class="__BODY_CLASS__">
<header><div class="brand">KITTY <small>/ SENTINEL R2.1</small></div><span class="badge">DESIGN REVIEW · FIT PENDING</span></header>
<main>
<div class="intro"><h1>Same body. A tail of her own.</h1><p>Your current body stays. This revision adds a curved detachable tail, bevelled ear tips with inset details, and two subtle grooves in the lower phone frame. Choose Side to see the tail silhouette, or Tail joint to see how it detaches.</p></div>
<section class="review" id="review" aria-label="Robot design review">
<input class="view-radio" id="view-iso" type="radio" name="view" checked>
<input class="view-radio" id="view-front" type="radio" name="view">
<input class="view-radio" id="view-rear" type="radio" name="view">
<input class="view-radio" id="view-inside" type="radio" name="view">
<input class="view-radio" id="view-side" type="radio" name="view">
<input class="view-radio" id="view-joint" type="radio" name="view">
<div class="views" role="group" aria-label="Choose a view"><label for="view-iso">3D angle</label><label for="view-front">Front</label><label for="view-rear">Rear angle</label><label for="view-side">Side</label><label for="view-inside">Inside</label><label for="view-joint">Tail joint</label><span class="spacer"></span><button id="enable3d" type="button" disabled>Enable rotatable 3D</button></div>
<div class="stage" id="stage">
<figure class="iso"><img src="__ISO_IMAGE__" alt="Complete KITTY R2 draft from the front corner: landscape phone frame, passive cat corners, broad fixed neck, faceted body, two drive wheels and front sonar"></figure>
<figure class="front"><img src="__FRONT_IMAGE__" alt="Front view of the complete KITTY R2 draft"></figure>
<figure class="rear"><img src="__REAR_IMAGE__" alt="Rear corner view of R2.1, showing the curved detachable tail, keyed socket and lower service openings"></figure>
<figure class="inside"><img src="__INSIDE_IMAGE__" alt="Interior view with the covers hidden, showing motor mounts, low battery tray and raised electronics deck"></figure>
<figure class="side"><img src="__SIDE_IMAGE__" alt="Side view showing the upright curved tail at the rear of the original faceted body"></figure>
<figure class="joint"><img src="__JOINT_IMAGE__" alt="Exploded tail connection: tail pulled 35 mm rearward from the keyed rear-cover socket, with cross-screw bores visible"></figure>
<canvas id="canvas" tabindex="0" aria-label="Interactive robot model. Drag to rotate; scroll or pinch to zoom. Arrow keys rotate; plus/minus zoom; Home resets."></canvas>
</div>
<div class="orbit"><button id="reset" type="button">Reset view</button><button id="zoomIn" type="button" aria-label="Zoom in">Zoom +</button><button id="zoomOut" type="button" aria-label="Zoom out">Zoom −</button><span>Drag to rotate · Scroll / pinch to zoom · Choose a saved view to leave 3D</span></div>
<p class="state" id="state" role="status">Saved CAD view. Choose Side for the tail silhouette or Tail joint for the attachment.</p>
<noscript><p>The saved views above work with JavaScript disabled. Only rotatable 3D needs JavaScript.</p></noscript>
</section>
<div class="facts"><div class="fact"><span>Whole draft envelope</span><strong>__SIZE__ mm</strong></div><div class="fact"><span>Phone envelope you supplied</span><strong>164 × 76 × 8 mm</strong></div><div class="fact"><span>Parts proposed for printing</span><strong>__PART_COUNT__ separate pieces</strong></div></div>
<div class="below"><section><h2>Review the shape</h2><p>The body, fixed neck and measured component envelopes stay the same. The new tail slides into an asymmetric rear socket; a proposed M3 cross screw and nut hold it in place. Remove the screw and pull the tail straight backward. The Tail joint view separates the pieces by 35 mm to show the key; the screw is omitted.</p><p>The tail sits above the lower service openings. Its proposed clearance is 0.4 mm per side; a fit sample and load check are still needed. Review its curve, length and the small frame details before we prepare the final STL print set.</p><a class="save" href="__ISO_IMAGE__" download="KITTY-R2-DRAFT.png">Save the coloured overview</a></section><details><summary>Before creating the final print set</summary><p>The draft uses your 62 mm wheel diameter and 61 × 20 mm motor length/width. We still need motor height and shaft position, wheel hub fit, caster, AA holder, phone case/camera access, and printer bed/material/nozzle.</p><p>Each part needs fit and slicer/support review. The complete robot includes visual stand-ins for bought components; it is not a single object to print. Design approval and physical fit approval are separate steps.</p></details></div>
</main>
<footer>Actual saved draft CAD views · Millimetres · No hardware or printer is connected · R2.1 review draft · Source: psychspy7/KITTY-ROBOT</footer>
<script id="mesh-data" type="application/octet-stream">__MESH_DATA__</script>
<script>
'use strict';
(() => {
 const $=id=>document.getElementById(id), canvas=$('canvas'), review=$('review'), button=$('enable3d');
 const encoded=$('mesh-data').textContent.trim();
 if(!encoded)return;
 let gl=null,program=null,buffers=null,locations=null,positionLocation,normalLocation;
 let yaw=-0.58,elevation=0.65,zoom=1,frame=0,dead=false;
 const pointers=new Map();let pinch=0;
 button.disabled=false;
 function saved(message){review.classList.remove('interactive');pointers.clear();button.textContent=dead?'Use the saved views':'Enable rotatable 3D';button.disabled=dead;$('state').textContent=message||'Saved CAD view. Choose Side for the tail silhouette or Tail joint for the attachment.';}
 function shader(type,source){const s=gl.createShader(type);gl.shaderSource(s,source);gl.compileShader(s);if(!gl.getShaderParameter(s,gl.COMPILE_STATUS))throw Error('Shader unavailable');return s;}
 function buffer(values){const b=gl.createBuffer();gl.bindBuffer(gl.ARRAY_BUFFER,b);gl.bufferData(gl.ARRAY_BUFFER,values,gl.STATIC_DRAW);return b;}
 function initialize(){
  gl=canvas.getContext('webgl',{antialias:true,alpha:false,preserveDrawingBuffer:true});
  if(!gl)throw Error('WebGL unavailable');
  const vs=shader(gl.VERTEX_SHADER,'attribute vec3 position;attribute vec3 normal;uniform mat3 rotation;uniform float aspect;uniform float zoom;varying vec3 n;void main(){vec3 p=rotation*position;gl_Position=vec4(p.x*zoom/aspect,p.y*zoom,-p.z*0.25,1.0);n=rotation*normal;}');
  const fs=shader(gl.FRAGMENT_SHADER,'precision mediump float;varying vec3 n;void main(){vec3 a=normalize(n);if(!gl_FrontFacing)a=-a;float light=0.32+0.68*max(dot(a,normalize(vec3(-0.3,0.55,1.0))),0.0);gl_FragColor=vec4(vec3(0.91,0.92,0.88)*light,1.0);}');
  program=gl.createProgram();gl.attachShader(program,vs);gl.attachShader(program,fs);gl.linkProgram(program);
  if(!gl.getProgramParameter(program,gl.LINK_STATUS))throw Error('3D program unavailable');
  gl.deleteShader(vs);gl.deleteShader(fs);gl.useProgram(program);
  positionLocation=gl.getAttribLocation(program,'position');normalLocation=gl.getAttribLocation(program,'normal');
  locations={rotation:gl.getUniformLocation(program,'rotation'),aspect:gl.getUniformLocation(program,'aspect'),zoom:gl.getUniformLocation(program,'zoom')};
  const raw=atob(encoded),bytes=new Uint8Array(raw.length);for(let i=0;i<raw.length;i++)bytes[i]=raw.charCodeAt(i);
  const view=new DataView(bytes.buffer),count=view.getUint32(80,true);
  if(!count||bytes.length!==84+50*count)throw Error('Mesh could not load');
  const positions=new Float32Array(count*9),normals=new Float32Array(count*9),low=[Infinity,Infinity,Infinity],high=[-Infinity,-Infinity,-Infinity];
  for(let i=0;i<count;i++)for(let j=0;j<3;j++)for(let k=0;k<3;k++){
   const value=view.getFloat32(84+i*50+12+j*12+k*4,true);if(!Number.isFinite(value))throw Error('Invalid mesh');
   positions[i*9+j*3+k]=value;normals[i*9+j*3+k]=view.getFloat32(84+i*50+k*4,true);low[k]=Math.min(low[k],value);high[k]=Math.max(high[k],value);
  }
  const size=Math.max(...high.map((v,i)=>v-low[i]));if(!(size>0))throw Error('Empty mesh');
  const centre=high.map((v,i)=>(v+low[i])/2),half=high.map((v,i)=>(v-low[i])/size/2);
  for(let i=0;i<positions.length;i++)positions[i]=(positions[i]-centre[i%3])/size;
  buffers={positions:buffer(positions),normals:buffer(normals),vertices:count*3,half};
  gl.enable(gl.DEPTH_TEST);gl.clearColor(0.075,0.105,0.12,1);
 }
 function matrix(){const c=Math.cos(yaw),s=Math.sin(yaw),se=Math.sin(elevation),ce=Math.cos(elevation);return[c,se*s,-ce*s,-s,se*c,-ce*c,0,ce,se];}
 function draw(){
  frame=0;
  try{
  if(!buffers||dead||!review.classList.contains('interactive'))return;
  const rect=canvas.getBoundingClientRect(),ratio=Math.min(devicePixelRatio||1,2),w=Math.max(1,Math.round(rect.width*ratio)),h=Math.max(1,Math.round(rect.height*ratio));
  if(canvas.width!==w||canvas.height!==h){canvas.width=w;canvas.height=h;}
  const m=matrix(),half=buffers.half;let x=0,y=0;
  for(const a of [-1,1])for(const b of [-1,1])for(const c of [-1,1]){x=Math.max(x,Math.abs(m[0]*half[0]*a+m[3]*half[1]*b+m[6]*half[2]*c));y=Math.max(y,Math.abs(m[1]*half[0]*a+m[4]*half[1]*b+m[7]*half[2]*c));}
  const fit=0.82/Math.max(y,x/(w/h));
  gl.viewport(0,0,w,h);gl.clear(gl.COLOR_BUFFER_BIT|gl.DEPTH_BUFFER_BIT);gl.useProgram(program);
  gl.uniformMatrix3fv(locations.rotation,false,new Float32Array(m));gl.uniform1f(locations.aspect,w/h);gl.uniform1f(locations.zoom,fit*zoom);
  for(const [location,data] of [[positionLocation,buffers.positions],[normalLocation,buffers.normals]]){gl.bindBuffer(gl.ARRAY_BUFFER,data);gl.enableVertexAttribArray(location);gl.vertexAttribPointer(location,3,gl.FLOAT,false,0,0);}
  gl.drawArrays(gl.TRIANGLES,0,buffers.vertices);
  }catch(error){dead=true;saved('Interactive 3D stopped. The saved CAD views remain available.');}
 }
 function schedule(){if(!frame)frame=requestAnimationFrame(draw);}
 button.onclick=()=>{if(dead)return;try{if(!buffers)initialize();review.classList.add('interactive');button.textContent='Rotatable 3D on';$('state').textContent='Drag to rotate. Saved views show the proposed colours. Choose any saved view to return.';schedule();canvas.focus({preventScroll:true});}catch(error){dead=true;saved('Interactive 3D is unavailable here. The six saved CAD views above still work.');}};
 for(const radio of document.querySelectorAll('.view-radio'))radio.addEventListener('change',()=>saved());
 function reset(){yaw=-0.58;elevation=0.65;zoom=1;schedule();}
 function changeZoom(factor){zoom=Math.max(0.35,Math.min(4,zoom*factor));schedule();}
 $('reset').onclick=reset;$('zoomIn').onclick=()=>changeZoom(1.2);$('zoomOut').onclick=()=>changeZoom(1/1.2);
 canvas.addEventListener('wheel',e=>{e.preventDefault();changeZoom(Math.exp(-e.deltaY*0.001));},{passive:false});
 function distance(){const a=[...pointers.values()];return a.length===2?Math.hypot(a[0].x-a[1].x,a[0].y-a[1].y):0;}
 canvas.addEventListener('pointerdown',e=>{canvas.setPointerCapture(e.pointerId);pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});pinch=distance();});
 canvas.addEventListener('pointermove',e=>{const old=pointers.get(e.pointerId);if(!old)return;pointers.set(e.pointerId,{x:e.clientX,y:e.clientY});if(pointers.size===1){yaw+=(e.clientX-old.x)*.009;elevation=Math.max(-1.5,Math.min(1.57,elevation+(e.clientY-old.y)*.009));schedule();}else{const d=distance();if(pinch>0&&d>0)changeZoom(d/pinch);pinch=d;}});
 function release(e){pointers.delete(e.pointerId);pinch=distance();}for(const name of ['pointerup','pointercancel','lostpointercapture'])canvas.addEventListener(name,release);
 canvas.addEventListener('keydown',e=>{if(!['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','+','=','-','Home'].includes(e.key))return;e.preventDefault();if(e.key==='Home')return reset();if(e.key==='+'||e.key==='=')return changeZoom(1.15);if(e.key==='-')return changeZoom(1/1.15);if(e.key==='ArrowLeft')yaw-=.1;if(e.key==='ArrowRight')yaw+=.1;if(e.key==='ArrowUp')elevation=Math.min(1.57,elevation+.1);if(e.key==='ArrowDown')elevation=Math.max(-1.5,elevation-.1);schedule();});
 canvas.addEventListener('webglcontextlost',e=>{e.preventDefault();dead=true;saved('3D stopped. The saved CAD views remain available.');});
 window.addEventListener('resize',schedule);
})();
</script>
</body>
</html>
